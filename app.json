{
  "expo": {
    "name": "לוח יהודי",
    "slug": "luach-yehudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FBFAF3"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.yaakovkatz.luachyehudi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-dev-client",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/frank-ruhl-libre/400Regular/FrankRuhlLibre_400Regular.ttf",
            "node_modules/@expo-google-fonts/frank-ruhl-libre/500Medium/FrankRuhlLibre_500Medium.ttf",
            "node_modules/@expo-google-fonts/heebo/400Regular/Heebo_400Regular.ttf",
            "node_modules/@expo-google-fonts/heebo/500Medium/Heebo_500Medium.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E4",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#17140F"
          }
        }
      ],
      "expo-sharing",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#A32D2D"
        }
      ]
    ],
    "scheme": "luachyehudi"
  }
}
