{
  "expo": {
    "name": "לוח יהודי",
    "slug": "luach-yehudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FBFAF3"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.yaakovkatz.luachyehudi",
      "permissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-dev-client",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/frank-ruhl-libre/400Regular/FrankRuhlLibre_400Regular.ttf",
            "node_modules/@expo-google-fonts/frank-ruhl-libre/500Medium/FrankRuhlLibre_500Medium.ttf",
            "node_modules/@expo-google-fonts/heebo/400Regular/Heebo_400Regular.ttf",
            "node_modules/@expo-google-fonts/heebo/500Medium/Heebo_500Medium.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E4",
          "dark": {
            "image": "./assets/splash-blank.png",
            "backgroundColor": "#17140F"
          }
        }
      ],
      "expo-sharing",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#A32D2D"
        }
      ],
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/frank-ruhl-libre/400Regular/FrankRuhlLibre_400Regular.ttf",
            "./node_modules/@expo-google-fonts/heebo/400Regular/Heebo_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "HebrewDate",
              "previewImage": "./assets/widgets/HebrewDate.png",
              "label": "תאריך עברי",
              "description": "התאריך העברי של היום, מתחלף בשקיעה",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextUp",
              "previewImage": "./assets/widgets/NextUp.png",
              "label": "הבא בתור",
              "description": "האירוע המשפחתי או התזכורת הקרובים",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ZmanimShabbat",
              "previewImage": "./assets/widgets/ZmanimShabbat.png",
              "label": "זמנים ושבת",
              "description": "הזמן הבא, הדלקת נרות וצאת השבת",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Month",
              "previewImage": "./assets/widgets/Month.png",
              "label": "החודש",
              "description": "החודש העברי, עם היום ושבתות",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "react-native-notify-kit"
    ],
    "scheme": "luachyehudi"
  }
}
