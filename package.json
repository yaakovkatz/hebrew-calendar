{
  "name": "luach-yehudi",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/frank-ruhl-libre": "^0.4.1",
    "@expo-google-fonts/heebo": "^0.4.2",
    "@hebcal/core": "^6.14.6",
    "expo": "~58.0.17",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.7",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.24.0",
    "react-native-notify-kit": "^10.9.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@hebcal/.*|temporal-polyfill|temporal-utils|quick-lru)"
    ],
    "moduleNameMapper": {
      "^@hebcal/core$": "<rootDir>/node_modules/@hebcal/core/dist/esm/index.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ]
  }
}
